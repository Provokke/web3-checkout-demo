{
  "name": "@provokke/web3-checkout-client",
  "version": "0.1.0",
  "description": "Small TypeScript client for the Checkout escrow: wallet connect (EIP-1193) and pay flow, demoed against a local anvil node.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Provokke/web3-checkout-demo.git",
    "directory": "client"
  },
  "author": "Provokke <josh@provokke.com>",
  "files": [
    "dist",
    "!dist/demo.*",
    "!dist/anvil.*"
  ],
  "main": "./dist/pay.js",
  "types": "./dist/pay.d.ts",
  "exports": {
    ".": {
      "types": "./dist/pay.d.ts",
      "default": "./dist/pay.js"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "demo": "tsx src/demo.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.14.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  }
}
